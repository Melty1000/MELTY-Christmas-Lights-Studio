#!/usr/bin/env sh

msg_file="$1"

model_line="$(grep -Ei '^Codex-Model:[[:space:]]*[^[:space:]].*$' "$msg_file" || true)"
machine_line="$(grep -Ei '^Commit-Machine:[[:space:]]*(desktop|laptop)[[:space:]]*$' "$msg_file" || true)"

if [ -z "$model_line" ] || [ -z "$machine_line" ]; then
  echo ""
  echo "Commit metadata is required."
  echo ""
  echo "Add these trailers to the commit message:"
  echo ""
  echo "Codex-Model: GPT-5 Codex"
  echo "Commit-Machine: desktop"
  echo ""
  echo "Commit-Machine must be either: desktop or laptop"
  exit 1
fi
